# Copy to .env in this directory before running `docker compose up` to
# override the defaults baked into docker-compose.yml.

# Password for the `agentforge` Postgres role that owns the schema
# (control-plane's migrations run as this role).
POSTGRES_PASSWORD=agentforge_dev_password

# Password for the scoped `agentforge_execution` Postgres role, created by
# control-plane's 0002_execution_plane_role migration and used exclusively
# by the execution-platform service.
EXECUTION_ROLE_PASSWORD=execution_dev_password

# Static bearer token both services accept (Phase-1 auth shim). Every
# non-/healthz request must send `Authorization: Bearer <this value>`.
DEV_BEARER_TOKEN=dev-local-token
